{
  "dataset": "fin-chat-golden",
  "version": 3,
  "description": "Golden cases for finance AI chat via am-ai-gateway. Asserts artifactType + MCP tool names + data keys.",
  "items": [
    {
      "id": "portfolio-summary",
      "input": {
        "message": "Give me my portfolio summary"
      },
      "expected": {
        "artifactType": "portfolio.summary.v1",
        "requireToolsUsed": true,
        "requiredToolsAny": ["get_portfolio_summary"],
        "forbidTools": ["ask_finance_agent"],
        "requiredDataKeys": ["currentValue", "investmentValue"]
      }
    },
    {
      "id": "holdings",
      "input": {
        "message": "Show my holdings"
      },
      "expected": {
        "artifactType": "holdings.list.v1",
        "requireToolsUsed": true,
        "requiredToolsAny": ["get_holdings"],
        "forbidTools": ["ask_finance_agent"],
        "requiredDataKeys": ["holdings", "count"]
      }
    },
    {
      "id": "top-movers",
      "input": {
        "message": "What are my top movers today?"
      },
      "expected": {
        "artifactType": "portfolio.movers.v1",
        "requireToolsUsed": true,
        "requiredToolsAny": ["get_top_movers"],
        "forbidTools": ["ask_finance_agent"],
        "requiredDataKeysAny": ["gainers", "movers"]
      }
    },
    {
      "id": "sector-allocation",
      "input": {
        "message": "Show my sector allocation"
      },
      "expected": {
        "artifactType": "portfolio.sector_allocation.v1",
        "requireToolsUsed": true,
        "requiredToolsAny": ["get_sector_allocation"],
        "forbidTools": ["ask_finance_agent"],
        "requiredDataKeysAny": ["sectorAllocation", "sectors"]
      }
    },
    {
      "id": "recent-activity",
      "input": {
        "message": "Show my recent trades"
      },
      "expected": {
        "artifactType": "trades.recent.v1",
        "requireToolsUsed": true,
        "requiredToolsAny": ["get_recent_activity"],
        "forbidTools": ["ask_finance_agent"],
        "requiredDataKeys": ["activities", "count"]
      }
    },
    {
      "id": "market-quote",
      "input": {
        "message": "What is the price of RELIANCE?"
      },
      "expected": {
        "artifactType": "market.quote.v1",
        "requireToolsUsed": true,
        "requiredToolsAny": ["get_stock_quote"],
        "forbidTools": ["ask_finance_agent"]
      }
    },
    {
      "id": "hello-text",
      "input": {
        "message": "hello"
      },
      "expected": {
        "artifactType": "text.v1",
        "requireToolsUsed": false,
        "forbidTools": ["ask_finance_agent"]
      }
    }
  ]
}
