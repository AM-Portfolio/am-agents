# Secrets — never COMMIT real env files (use .env.example templates only).
# Gitignore does NOT delete local files — your .env.preprod stays on disk.
.env
.env.*
.env-vault
!.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
*.db
*.db-shm
*.db-wal

# Node
node_modules/

# Runtime logs
logs/
*.log

# Local kube / credentials
kubeconfig*
**/generated-credentials.txt

# Local FakeMail E2E dumps (do not commit)
docs/samples/e2e_mail/

