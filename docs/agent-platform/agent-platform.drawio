  <diagram id="anti-dupe" name="Anti-dupe Rules">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;Anti-duplication — PR blockers&lt;/b&gt;" style="text;html=1;fontSize=18;fontColor=#111827;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="380" y="24" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="r" value="1. No per-agent Protocol copies — use shared ports&#10;2. One Cliq render path — freeze infra relay formatter fork&#10;3. No vendor types in workflows — opaque refs only&#10;4. No prompt strings in Python — PromptRegistry keys&#10;5. Shared HTTP/OTel via agent-common — ban forks&#10;6. FailoverDocStore wrapper — not forked MinIO/GDrive logic&#10;7. Jira = new TicketStore adapter — not OP fork&#10;8. Multi-port sequences → shared services module&#10;9. Feature flags at composition root only&#10;10. Cards via Notifier.send_card — not raw POST in handler" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=16;spacingTop=10;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=13;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="80" y="70" width="1000" height="320" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
