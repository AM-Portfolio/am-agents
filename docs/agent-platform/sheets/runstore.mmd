flowchart TB
  subgraph intake ["A. Intake — every request"]
    Req["AlertIncident / SPT / Verify request"]
    Create["RunStore.create_run initial status"]
  end

  subgraph orch ["B. Temporal"]
    WF["Workflow + activities via ports"]
    Step["Execute step"]
    Upd["RunStore.upsert_step + rollup"]
  end

  subgraph db ["C. Postgres RunStore"]
    Runs["agent_runs"]
    Steps["agent_run_steps"]
    Claim["claim pending SKIP LOCKED"]
  end

  subgraph verify ["D. Post-fix verify gate A"]
    Fix["InfraOps work_done"]
    VRun["create_run kind=verify"]
    M["metrics check_ref"]
    L["logs check_ref"]
    H["health / custom"]
    Pass["passed → unblock done"]
    Fail["failed → reopen / escalate"]
  end

  Req --> Create --> Runs
  Create --> WF
  WF --> Step --> Upd
  Upd --> Steps
  Upd --> Runs
  Upd -->|more| Step

  Fix --> VRun --> Steps
  Claim --> M --> L --> H
  H -->|all pass| Pass
  H -->|any fail| Fail
  Pass --> Runs
  Fail --> Runs

  linkStyle default stroke:#0EA5E9,stroke-width:2px,color:#0F172A

  classDef core fill:#BBF7D0,stroke:#15803D,stroke-width:2px,color:#14532D
  classDef provider fill:#FDE68A,stroke:#B45309,stroke-width:2px,color:#78350F
  classDef alert fill:#FECDD3,stroke:#E11D48,stroke-width:2px,color:#881337
  classDef dest fill:#BFDBFE,stroke:#1D4ED8,stroke-width:2px,color:#1E3A8A

  class Create,Upd,Claim,WF,Step core
  class Runs,Steps,M,L,H provider
  class Req,Fix,VRun alert
  class Pass,Fail dest
