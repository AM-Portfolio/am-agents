flowchart TB
  subgraph triggers ["A. Triggers"]
    Graf["Grafana FIRING"]
    Res["Grafana RESOLVED"]
    Silence["Silence - ignored"]
  end

  subgraph edge ["B. Alert Ops edge"]
    Hook["StartWorkflow alert-tracking_id"]
    SigR["Signal alert.resolved"]
    SigF["Signal alert.refired"]
  end

  subgraph wf ["C. AlertIncidentWorkflow"]
    Triage["TriagePort.classify"]
    Dir["DirectoryPort.resolve"]
    Ticket["TicketStore.create + assign"]
    Notify["Notifier ticket.created + card"]
    Close["first closer wins"]
  end

  subgraph adapters ["D. Adapters"]
    OP["OpenProject"]
    Cliq["Cliq follow-up card"]
  end

  Graf --> Hook --> Triage --> Dir --> Ticket --> Notify
  Ticket --> OP
  Notify --> Cliq
  Res --> SigR --> Close
  Graf -.->|re-FIRING while open| SigF
  SigF --> Ticket
  Silence -.->|no close| Silence
  Close --> OP
  Close --> Cliq

  linkStyle default stroke:#0EA5E9,stroke-width:2px,color:#0F172A

  classDef core fill:#BBF7D0,stroke:#15803D,stroke-width:2px,color:#14532D
  classDef provider fill:#FDE68A,stroke:#B45309,stroke-width:2px,color:#78350F
  classDef alert fill:#FECDD3,stroke:#E11D48,stroke-width:2px,color:#881337
  classDef external fill:#FFFFFF,stroke:#2563EB,stroke-width:2px,color:#0F172A

  class Triage,Dir,Ticket,Notify,Close,Hook,SigR,SigF core
  class OP,Cliq provider
  class Graf,Res,Silence alert
