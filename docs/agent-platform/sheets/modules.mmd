    V1["OpenProject / Jira"]
    V2["Cliq"]
    V3["MinIO / GDrive"]
    V4["Langfuse / prompt http"]
    V5["Grafana HTTP observe"]
  end

  subgraph catalog ["catalog/prompts OWNS"]
