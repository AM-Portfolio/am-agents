{
  "name": "am-agents",
  "version": "0.1.0",
  "private": true,
  "description": "AM AI agents monorepo (tool-agent, db-agent, support-agent, fin-portfolio)",
  "workspaces": [
    "db-agent",
    "fin-portfolio-agent",
    "fin-api-testing-agent",
    "tool-agent"
  ],
  "scripts": {
    "db-agent:dev": "npm run dev -w @am/db-agent",
    "db-agent:preprod": "npm run preprod -w @am/db-agent",
    "db-agent:test": "npm run test -w @am/db-agent",
    "db-agent:logs:clean": "npm run logs:clean -w @am/db-agent",
    "tool-agent:dev": "npm run dev -w @am/tool-agent",
    "tool-agent:preprod": "npm run preprod -w @am/tool-agent",
    "tool-agent:test": "npm run test -w @am/tool-agent",
    "fin-portfolio:dev": "npm run dev -w @am/fin-portfolio-agent",
    "fin-portfolio:ui": "npm run ui -w @am/fin-portfolio-agent",
    "fin-portfolio:test": "npm run test -w @am/fin-portfolio-agent",
    "fin-api-test:dev": "npm run dev -w @am/fin-api-testing-agent",
    "fin-api-test:test": "npm run test -w @am/fin-api-testing-agent",
    "dev": "npm run db-agent:dev",
    "preprod": "npm run db-agent:preprod",
    "start": "npm run dev",
    "start:preprod": "npm run preprod",
    "test": "npm run db-agent:test && npm run tool-agent:test && npm run fin-portfolio:test && npm run fin-api-test:test",
    "logs:clean": "npm run db-agent:logs:clean"
  }
}
