# Local SPT portal — copy to .env and edit. Never commit .env.

APP_PORT=8150
ROOT_PATH=
LOG_LEVEL=INFO
DATA_DIR=./data

# Windows: use vendor\bin\k6.exe (run-local downloads if missing). Linux: ./vendor/bin/k6
K6_BIN=./vendor/bin/k6.exe

# Hit shared public hosts from your laptop (not in-cluster DNS)
# Prefer am-dev for local laptop access if am.asrax.in returns 503
POC_TARGET_URL=https://am-dev.asrax.in/analysis
SPT_IDENTITY_URL=https://am-dev.asrax.in/identity
SPT_PUBLIC_BASE_URL=http://localhost:8150

DEFAULT_ENVIRONMENT=dev
DEFAULT_RUN_PROFILE=debug

# Demo login (am-identity)
SPT_AUTH_USERNAME=ssd2658@gmail.com
SPT_AUTH_PASSWORD=
SPT_USER_ID=ssd2658

# Optional — Influx (required for Grafana SPT board to fill)
INFLUXDB_URL=http://influxdb.infra.svc.cluster.local:8086
INFLUXDB_ORG=am-portfolio
INFLUXDB_BUCKET=load-testing-dev
INFLUXDB_TOKEN=
GRAFANA_PUBLIC_URL=https://grafana.asrax.in
GRAFANA_K6_DASHBOARD_UID=spt-load-testing

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
TESTKUBE_ENABLED=false

# Persistence: json | dual | db (default db). Rollback: SPT_STORE=json
SPT_STORE=db
# Empty = SQLite at {DATA_DIR}/spt.db
# SPT_DATABASE_URL=postgresql+psycopg://spt:spt@localhost:5432/spt

# ACL — set true to require API keys on mutating /api/*
SPT_ACL_REQUIRED=false
# Optional bootstrap keys role:name:secret,...
# SPT_BOOTSTRAP_KEYS=developer:local-dev:spt_sk_dev_localchange_me,agent:local-agent:spt_sk_agent_localchange_me
SPT_MAX_CONCURRENT_RUNS=3
SPT_RUN_RETENTION_DAYS=30

# Schema-first payloads — LLM HTTP fallback (off by default)
SPT_PAYLOAD_LLM_FALLBACK=false
# SPT_FIN_API_TESTING_URL=http://localhost:9xxx
