{
  "apiVersion": "v1",
  "spec": {
    "containers": [
      {
        "name": "seed",
        "image": "busybox",
        "command": ["sleep", "600"],
        "volumeMounts": [{ "name": "data", "mountPath": "/data" }]
      }
    ],
    "volumes": [
      {
        "name": "data",
        "persistentVolumeClaim": { "claimName": "am-spt-poc-data" }
      }
    ]
  }
}
