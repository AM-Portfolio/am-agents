# am-agents — copy to .env (gitignored)
AM_PLATFORM_ENV_FILE=../am-obs-platform/.env

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-platform

ALERT_NOTIFY_PROVIDER=cliq
TICKET_PROVIDER=fake
DIRECTORY_PROVIDER=fake
RUN_STORE_PROVIDER=fake
DOC_PROVIDER=minio
MAIL_PROVIDER=fake
CALENDAR_PROVIDER=fake

# OPENPROJECT_URL=https://openproject.asrax.in
# OPENPROJECT_API_TOKEN=CHANGE_ME
# OPENPROJECT_PROJECT_ID=3
# OPENPROJECT_TYPE_ID=1
# OPENPROJECT_DEFAULT_ASSIGNEE_LOGIN=munish
# OPENPROJECT_ADMIN_LOGIN=admin
# OPENPROJECT_ADMIN_PASSWORD=CHANGE_ME

# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=CHANGE_ME
# JIRA_PROJECT_KEY=OPS
# JIRA_ISSUE_TYPE=Task

# ZOHO_MAIL_ACCESS_TOKEN=
# ZOHO_MAIL_ACCOUNT_ID=
# ZOHO_MAIL_FROM=
# ZOHO_CALENDAR_ACCESS_TOKEN=
# ZOHO_CALENDAR_UID=

MINIO_ENDPOINT=http://minio.infra.svc.cluster.local:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=agent-docs

# Phase 5 — L2 gateway
GATEWAY_API_TOKEN=CHANGE_ME
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8090

# SPT runaway guards / prod policy
SPT_ENV=lab
SPT_MAX_TARGETS_PER_RUN=20
SPT_MAX_PARALLEL=5
SPT_MAX_CONCURRENT_RUNS=3
# SPT_ALLOW_ALL=1
# SPT_APPROVED=1
# SPT_CHANGE_WINDOW_OPEN=1

# Alert LLM routing — Gemini direct (vault) or LiteLLM openai_compat
ALERT_ANALYSIS=llm
LLM_PROVIDER=gemini
# GEMINI_API_KEY=CHANGE_ME
# LLM_MODEL=gemini-2.0-flash
# LLM_PROVIDER=openai_compat
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_MASTER_KEY=CHANGE_ME
PROMPT_PROVIDER=file
ALERT_DECISION_MIN_CONFIDENCE=0.6

# IT-Support-agent identity (author via OPENPROJECT_API_TOKEN user + Cliq webhook owner)
AGENT_DISPLAY_NAME=IT-Support-agent
# Envs allowed for auto_infra (prod excluded until soak)
AGENT_AUTO_INFRA_ENVS=lab,dev,preprod,infra,unknown
# VERIFY_FORCE_RESULT only for unit tests; live path uses Prometheus
AGENT_VERIFY_FORCE_ENVS=lab
# OBSERVE_PROVIDER=fake|prometheus|tool_agent
OBSERVE_PROVIDER=prometheus
PROMETHEUS_URL=http://localhost:9090/prometheus
# When set with prometheus: redis verify uses tool-agent redis.info (real), else PromQL
TOOL_AGENT_URL=http://localhost:8141
TOOL_AGENT_CALLER=platform-worker
# Optional: TOOL_AGENT_PROM_DATASOURCE_UID=...
# Optional: AGENT_CLIQ_CHANNEL_MAP={"prod":"cliq:prod","preprod":"cliq:lab"}
# ZOHO_CLIQ_PROD_WEBHOOK_URL=

# Langfuse (platform-worker LLM traces)
LANGFUSE_ENABLED=true
# LANGFUSE_HOST=https://langfuse.munish.org
# LANGFUSE_PUBLIC_KEY=CHANGE_ME
# LANGFUSE_SECRET_KEY=CHANGE_ME
