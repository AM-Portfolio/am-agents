# am-agents — copy to .env (gitignored)
AM_PLATFORM_ENV_FILE=../am-obs-platform/.env

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-platform

ALERT_NOTIFY_PROVIDER=cliq
TICKET_PROVIDER=fake
DIRECTORY_PROVIDER=fake
RUN_STORE_PROVIDER=fake
DOC_PROVIDER=minio
MAIL_PROVIDER=fake
CALENDAR_PROVIDER=fake

# OPENPROJECT_URL=https://openproject.asrax.in
