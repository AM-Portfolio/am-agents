SUPPORT_AGENT_API_TOKEN=change-me
SUPPORT_AGENT_GATEWAY_HOST=0.0.0.0
SUPPORT_AGENT_GATEWAY_PORT=8091
SUPPORT_AGENT_RUNSTORE=memory
# Local durable mode (do not use as multi-replica production ledger):
# SUPPORT_AGENT_RUNSTORE=sqlite
# SUPPORT_AGENT_SQLITE_PATH=./data/support-agent-runs.db
# Dedicated A2A Postgres (schema support_agent.task_runs — not legacy agent_runs):
# SUPPORT_AGENT_RUNSTORE=postgres
# SUPPORT_AGENT_DATABASE_URL=postgresql://user:pass@localhost:5432/support_agent
# pip install 'am-support-agent[postgres]'

SUPPORT_AGENT_TEMPORAL_ENABLED=false
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=support-agent-v2

# OpenTelemetry traces (unset endpoint or set enabled=false to disable cleanly)
SUPPORT_AGENT_TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=support-agent
OTEL_SERVICE_NAMESPACE=am-agents
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# DEPLOYMENT_ENVIRONMENT=local

# Incident / SPT side-effect parity (default off)
# SUPPORT_AGENT_INCIDENT_PARITY=false
# SUPPORT_AGENT_SPT_PARITY=false
# SUPPORT_AGENT_ALLOW_UNSANDBOXED_SPT=false
# SUPPORT_AGENT_LLM_ENABLED=false
# SUPPORT_AGENT_CANARY_MODE=off
# SUPPORT_AGENT_CANARY_PERCENT=0
# SUPPORT_AGENT_CANARY_ALLOWLIST=
# SUPPORT_AGENT_FORCE_LEGACY=false

# GrowthBook runtime routing (GrowthBook overrides canary env routing when enabled).
# Create an SDK Connection in GrowthBook and store its client key in Vault.
# GROWTHBOOK_ENABLED=false
# GROWTHBOOK_API_HOST=https://api.growthbook.asrax.in
# GROWTHBOOK_CLIENT_KEY=
# GROWTHBOOK_ROUTE_FEATURE_KEY=support-agent-route
# GROWTHBOOK_CACHE_TTL_SECONDS=60
# GROWTHBOOK_RETRY_SECONDS=30

# Optional catalog root override (defaults to monorepo catalog/)
# SUPPORT_AGENT_CATALOG_ROOT=/path/to/catalog

# DocStore namespace (client not wired yet)
# SUPPORT_AGENT_DOC_PREFIX=support-agent-v2/
# SUPPORT_AGENT_DOC_BUCKET=

# Specialist base URLs (defaults match local ports)
TOOL_AGENT_BASE_URL=http://127.0.0.1:8141
DB_AGENT_BASE_URL=http://127.0.0.1:8140
UI_TEST_AGENT_BASE_URL=http://127.0.0.1:8130
# TOOL_AGENT_MCP_URL=http://127.0.0.1:8085

# Optional override for agents.yaml
# AGENT_PLATFORM_REGISTRY=/path/to/agents.yaml
